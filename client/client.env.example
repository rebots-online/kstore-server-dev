# kstore client environment — schema only, no real credentials.
# Copy to ~/.config/kstore/client.env, chmod 600, then fill deployment
# values. Override the location with KSTORE_CONFIG_FILE. Environment
# variables override file values. No project document lists here —
# documents are invocation data (manifests), never configuration.

# Base URLs (scheme + host + port); routes are derived in one module
# (client/kstore_client.py), never configured per-endpoint.
KSTORE_URL=http://192.168.0.87:8788
KSTORE_QDRANT_URL=http://192.168.0.87:6333
KSTORE_COLLECTION=knowledge

# Durable receipts + failed-write outbox root (expanded with ~).
KSTORE_RECEIPT_ROOT=~/.local/state/kstore/receipts
KSTORE_REQUEST_TIMEOUT_SECONDS=180

# Independent PostgreSQL read channel: JSON argv receiving SQL on stdin,
# emitting tab-separated unaligned rows. On .87 (passwordless sudo docker):
#   ["sudo","-n","docker","exec","-i","kstore-postgres","psql","-U","admin","-d","kstore","-At","-F","\t","-v","ON_ERROR_STOP=1"]
# On a workstation (ssh, no local docker):
#   ["ssh","robin@192.168.0.87","psql","-U","admin","-d","kstore","-At","-F","\t","-v","ON_ERROR_STOP=1"]
KSTORE_POSTGRES_READ_COMMAND_JSON=["sudo","-n","docker","exec","-i","kstore-postgres","psql","-U","admin","-d","kstore","-At","-F","\t","-v","ON_ERROR_STOP=1"]

# Optional secrets: actual values live only in the private config/environment.
#KSTORE_HTTP_BEARER_TOKEN=
#KSTORE_QDRANT_API_KEY=

# Review is hosted reasoning, independent of the short storage request timeout.
KSTORE_REVIEW_TIMEOUT_SECONDS=1800
