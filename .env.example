# kstore server environment — schema only, no real credentials.
# Copy to the repo-root .env (gitignored) or set real environment variables.
# Process env (e.g. the systemd unit's Environment= lines) overrides the file.
# kstore/config.py is the single reader; no other module parses topology.

# Required for any Postgres-touching entry point (concierge, ingest, MCP).
# Standard solopreneur credential: admin / DOCS/PASSWORDS.md — never a
# per-service mint. Never commit the real value.
KSTORE_PG_DSN=postgresql://admin:PASSWORD@192.168.0.87:5432/kstore

# Reference deployment topology (.87 LAN).
KSTORE_QDRANT_URL=http://192.168.0.87:6333
KSTORE_OLLAMA_URL=http://192.168.0.87:11434
KSTORE_CONCIERGE_URL=http://192.168.0.87:8788

# Models / collection (embedding model is baked into the collection;
# switching embedders = re-ingest).
KSTORE_CONCIERGE_MODEL=glm-5.3-flash
KSTORE_EMBED_MODEL=qwen3-embedding:8b
KSTORE_COLLECTION=knowledge

# Retrieval knobs.
KSTORE_TOP_K=10
KSTORE_MAX_RESULTS=5
KSTORE_SCORE_FLOOR=0.35

# Embedding policy — defaults measured 2026-09-27 on .87 (idle GPU):
# ~0.33-0.44 s per 1k-char text, 16x3600-char batch ~7 s. Timeout is ~10x
# the worst measured batch; deadline bounds a whole document write.
KSTORE_EMBED_BATCH=4
KSTORE_EMBED_TIMEOUT=90
KSTORE_EMBED_RETRIES=2
KSTORE_EMBED_DEADLINE=600

# Optional: require 'Authorization: Bearer <token>' on the concierge
# (except /health). Unset = LAN-trusted no-auth default.
#KSTORE_HTTP_BEARER_TOKEN=

# Hosted concierge (ZAI_API_KEY is accepted when the explicit key is unset).
KSTORE_CONCIERGE_BASE_URL=https://api.z.ai/api/paas/v4
#KSTORE_CONCIERGE_API_KEY=
KSTORE_EMBED_DIMS=4096
# Overall deadline is separate from the short stalled-stream timeout.
KSTORE_REVIEW_TIMEOUT=360
KSTORE_REVIEW_IDLE_TIMEOUT=30
KSTORE_REVIEW_CONNECT_TIMEOUT=10
KSTORE_REVIEW_MAX_TOKENS=16384
KSTORE_REVIEW_WINDOW_CHARS=120000
KSTORE_AUTHORITY_ROOT=/home/robin/Admin-Manual
KSTORE_WORKER_POLL=10
KSTORE_GPU_WINDOW=60
KSTORE_GPU_COOLDOWN=300
KSTORE_GPU_MIN_FREE_MB=6500
KSTORE_GPU_INDEX=0
KSTORE_GPU_RELEASE_TIMEOUT=30
KSTORE_GPU_STATE_PATH=/home/robin/.local/state/kstore/gpu.json
KSTORE_MINER_EXE=/home/robin/.local/bin/krig-miner
KSTORE_MINER_LAUNCHER=/home/robin/.local/bin/minekrig-prl.sh
KSTORE_MINER_SERVICE=kstore-prl-miner.service

KSTORE_GPU_DISPLAY_ALLOWLIST=gnome-remote-desktop-daemon,Xorg,Xwayland

# Required operator-owned schema1 reminder manifest; paths inside KSTORE_AUTHORITY_ROOT.
KSTORE_REMINDER_MANIFEST=
